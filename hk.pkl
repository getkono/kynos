amends "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Config.pkl"

min_hk_version = "1.53.0"
default_branch = "master"

hooks {
    ["pre-commit"] {
        fix = true
        stage = true
        stash = "git"
        steps {
            ["format"] {
                glob = "*.rs"
                check_first = true
                check = "mise run format:check"
                fix = "mise run format"
            }
            // `.cargo/config.toml` is in the glob for the reason `Cargo.toml`
            // is: it decides how the workspace builds. Its `[profile.dev]`
            // keys override the manifest's, and an invalid *value* there
            // fails every build on the branch while matching none of the
            // other steps' globs.
            //
            // A misspelled key is the weaker half and this step does not
            // catch it: cargo reports `unused config key profile.dev.debgu`
            // and exits 0, and a misspelled profile *table* is not reported
            // at all -- `-D warnings` is a rustc flag and never reaches a
            // cargo-level config warning. What would catch that is a gate
            // reading the file's own keys, which is filed as #127.
            ["lint"] {
                glob = List("*.rs", "Cargo.toml", "Cargo.lock", ".cargo/config.toml")
                check_first = true
                check = "mise run lint"
                fix = "mise run lint:fix"
                depends = List("format")
            }
            // Check-only: the script reports where a rule is broken and cannot
            // know which of the two edits that reach it -- the source or the
            // table it is counted against -- was the mistaken one.
            //
            // Here as well as in `hooks:pre-push` because the rules it holds are
            // layout rules, and layout is what a commit is reviewed as. It reads
            // committed text and compiles nothing, so it costs a fraction of the
            // Clippy pass above it. The globs are the inputs it actually reads:
            // the sources, the crate manifests, the four documents whose tables
            // it counts against, the script itself, and its tests.
            //
            // The tests run with the gate rather than in a step of their own.
            // A parser that breaks is what makes the gate pass over a table it
            // half read, so a green gate is worth exactly what the parsers
            // under it are -- and the two are edited in the same commit.
            ["containment"] {
                glob = List(
                    "*.rs",
                    "crates/*/Cargo.toml",
                    "docs/architecture.md",
                    "docs/nfr.md",
                    "docs/performance.md",
                    "docs/testing.md",
                    "scripts/containment.py",
                    "scripts/containment_test.py",
                )
                check = "mise run containment:check && mise run containment:test"
            }
        }
    }
    ["commit-msg"] {
        steps {
            // A merge in progress is exempt from this rule, and the exemption
            // lives inside the task rather than in a `step_condition` here.
            // hk's `exec()` returns a command's stdout and raises on a non-zero
            // exit, and `src/step/execution.rs` propagates that with `?`, so the
            // natural spelling of "skip when MERGE_HEAD resolves" would fail the
            // hook on every commit that is not a merge; only a literal
            // `Bool(false)` skips a step. And `src/test_runner.rs` evaluates no
            // condition and cannot render `{{commit_msg_file}}`, so an `hk test`
            // case could neither exercise one nor run this step at all. In the
            // task, the exemption is covered by `mise run commits:test`.
            //
            // That suite does not restate this step. It installs
            // `hk run commit-msg` as the `commit-msg` hook of a throwaway
            // repository and drives real commits and a real
            // `git merge --no-ff` through it, so hk resolves this file itself
            // and answers with the exit code git obeys. Rename the step,
            // delete it, move it under another hook or drop the
            // `< {{commit_msg_file}}` redirect, and the suite fails on what
            // the hook did rather than on what this file says.
            //
            // Asking hk is what no reading of this file could replace. Pkl
            // merges entries that share a key and hk obeys the merged result,
            // so a second `["conventional-commit"]` entry is the
            // authoritative one and is invisible to anything resolving a key
            // to its first, and hk merges settings from sources that are not
            // this file at all. An exit code is downstream of every one of
            // them.
            //
            // Measured on hk 1.53.0 against this file, over a non-conforming
            // message on a one-parent commit: a `step_condition`, `condition`,
            // `profiles`, `shell`, `prefix` or `required` key on this step, a
            // module-level `skip_steps` or `skip_hooks`, a second
            // `["conventional-commit"]` entry in this block, and a second
            // `["commit-msg"]` entry beside this hook each leave `hk validate`
            // green and the `check` below untouched while letting that message
            // through. Each one fails `mise run commits:test`.
            //
            // `glob`, `types` and `exclude` join that list at the values that
            // select nothing, and only there. Measured the same way, through a
            // real `commit-msg` hook over a real `git commit`: the file set hk
            // builds for this hook is the commit's *staged* files --
            // `DEBUG files: {"hk.pkl", "probe.txt"}` under `HK_LOG=debug`, the
            // message file not among them. So `glob = "*"` selects them, the
            // step runs and the gate stays armed, while
            // `glob = "*.no-such-extension"` selects none, hk skips the step
            // reporting `no file matches for step`, and the message goes
            // through. `mise run commits:test` fails on the narrowing values
            // and passes on `glob = "*"`, which is the right answer to each.
            // Selecting files is still not how this step is scoped: a value
            // matching everything staged today matches nothing on the commit
            // that stages only what it leaves out.
            ["conventional-commit"] {
                check = "mise run --quiet commits:message < {{commit_msg_file}}"
                output_summary = "stdout"
            }
        }
    }
    ["pre-push"] {
        steps {
            ["validate"] {
                // Git still invokes pre-push when it has no ref updates. hk preserves
                // Git's ref-update input as {{hook_stdin}}, so only run the expensive
                // checks when at least one update was proposed.
                check = "if IFS= read -r _; then mise run --quiet hooks:pre-push; fi"
                stdin = "{{ hook_stdin }}"
                exclusive = true
            }
        }
    }
}
