amends "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Config.pkl"

min_hk_version = "1.53.0"
default_branch = "master"

hooks {
    ["pre-commit"] {
        fix = true
        stage = true
        stash = "git"
        steps {
            ["format"] {
                glob = "*.rs"
                check_first = true
                check = "mise run format:check"
                fix = "mise run format"
            }
            // `.cargo/config.toml` decides how the workspace builds, as
            // `Cargo.toml` does; `containment:check` catches a misspelled key.
            ["lint"] {
                glob = List("*.rs", "Cargo.toml", "Cargo.lock", ".cargo/config.toml")
                check_first = true
                check = "mise run lint"
                fix = "mise run lint:fix"
                depends = List("format")
            }
            // Check-only: it cannot know whether the source or the table it is
            // counted against was the mistaken edit. The globs are what it reads;
            // its tests run with it because a broken parser passes a half-read table.
            ["containment"] {
                glob = List(
                    "*.rs",
                    "crates/*/Cargo.toml",
                    "docs/architecture.md",
                    "docs/nfr.md",
                    "docs/performance.md",
                    "docs/testing.md",
                    "scripts/containment.py",
                    "scripts/containment_test.py",
                )
                check = "mise run containment:check && mise run containment:test"
            }
        }
    }
    ["commit-msg"] {
        steps {
            // The task exempts a merge in progress; a `step_condition` cannot,
            // since hk's `exec()` raises on a non-zero exit. `mise run
            // commits:test` drives a real merge through this hook.
            ["conventional-commit"] {
                check = "mise run --quiet commits:message < {{commit_msg_file}}"
                output_summary = "stdout"
            }
        }
    }
    ["pre-push"] {
        steps {
            ["validate"] {
                // Git invokes pre-push even with no ref updates; run only when
                // {{hook_stdin}} proposes one.
                check = "if IFS= read -r _; then mise run --quiet hooks:pre-push; fi"
                stdin = "{{ hook_stdin }}"
                exclusive = true
            }
        }
    }
}
